{
  "name": "factura-luz-mcp",
  "mcpName": "io.github.ilopezluna/factura-luz",
  "version": "0.2.0",
  "type": "module",
  "description": "Servidor MCP que lee y explica facturas de la luz españolas (QR de la CNMC). Funciona en local: la factura no sale de tu ordenador.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "factura",
    "electricidad",
    "luz",
    "cnmc",
    "spain"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ilopezluna/entiende-tu-factura.git",
    "directory": "mcp"
  },
  "homepage": "https://github.com/ilopezluna/entiende-tu-factura/tree/main/mcp",
  "bugs": {
    "url": "https://github.com/ilopezluna/entiende-tu-factura/issues"
  },
  "bin": {
    "factura-luz-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@napi-rs/canvas": "^1.0.9",
    "jsqr": "^1.4.0",
    "pdfjs-dist": "^6.3.289",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "tsup": "^8.3.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
