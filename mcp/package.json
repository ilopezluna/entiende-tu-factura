{
  "name": "factura-luz-mcp",
  "version": "0.1.0",
  "type": "module",
  "description": "Servidor MCP que lee y explica facturas de la luz españolas (QR de la CNMC). Funciona en local: la factura no sale de tu ordenador.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "factura",
    "electricidad",
    "luz",
    "cnmc",
    "spain"
  ],
  "license": "MIT",
  "bin": {
    "factura-luz-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@napi-rs/canvas": "^0.1.60",
    "jsqr": "^1.4.0",
    "pdfjs-dist": "^5.7.284",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
