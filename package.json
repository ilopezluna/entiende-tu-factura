{
  "name": "entiende-tu-factura",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "mcp"
  ],
  "description": "Sube tu factura de la luz y entiende qué estás pagando. 100% en el navegador, sin backend.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "npm run format:check && npm run typecheck && npm test && npm run test:mcp",
    "build:mcp": "npm run build -w factura-luz-mcp",
    "test:mcp": "npm run typecheck -w factura-luz-mcp && npm test -w factura-luz-mcp"
  },
  "dependencies": {
    "jsqr": "^1.4.0",
    "lucide-react": "^1.49.0",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
